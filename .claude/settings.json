{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(./**)",

      "Bash(.venv/Scripts/python.exe *)",
      "Bash(.venv/bin/python *)",
      "Bash(python *)",
      "Bash(py *)",
      "Bash(pytest *)",
      "PowerShell(.venv/Scripts/python.exe *)",
      "PowerShell(.venv\\Scripts\\python.exe *)",
      "PowerShell(python *)",
      "PowerShell(py *)",
      "PowerShell(pytest *)",

      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(git *)",

      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-Location)",
      "PowerShell(Measure-Object *)",
      "PowerShell(Select-Object *)",
      "PowerShell(Where-Object *)",
      "PowerShell(Sort-Object *)",
      "PowerShell(Get-Command *)",
      "PowerShell(Get-Item *)",
      "PowerShell(New-Item *)",
      "PowerShell(Copy-Item *)",
      "PowerShell(Move-Item *)",
      "PowerShell(git *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git tag -d *)",

      "PowerShell(git push *)",
      "PowerShell(git pull *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git restore *)",
      "PowerShell(git branch -D *)",

      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(pip install *)",
      "Bash(python -m pip install *)",
      "PowerShell(pip install *)",
      "PowerShell(python -m pip install *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f*)",

      "Bash(rm * /)",
      "Bash(rm * /*)",
      "Bash(rm * ~*)",
      "Bash(rm * $HOME*)",
      "Bash(rm * ..*)",
      "Bash(rm * .)",
      "Bash(rm * C:*)",
      "Bash(rm * c:*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(chmod -R *)",
      "Bash(chown -R *)",

      "PowerShell(Remove-Item * C:*)",
      "PowerShell(Remove-Item C:*)",
      "PowerShell(Remove-Item * ~*)",
      "PowerShell(Remove-Item ~*)",
      "PowerShell(Remove-Item * $HOME*)",
      "PowerShell(Remove-Item $HOME*)",
      "PowerShell(Remove-Item * $env:*)",
      "PowerShell(Remove-Item $env:*)",
      "PowerShell(Remove-Item * ..*)",
      "PowerShell(Remove-Item ..*)",
      "PowerShell(Format-Volume *)",
      "PowerShell(Clear-Disk *)",
      "PowerShell(Initialize-Disk *)",
      "PowerShell(Stop-Computer *)",
      "PowerShell(Restart-Computer *)",

      "Read(./private/**)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Bash(cat *.env*)",
      "PowerShell(Get-Content *.env*)",

      "Edit(./.claude/settings*.json)"
    ]
  }
}